[Desktop Entry]
Type=Application
Name=FIFINE Deck
Comment=Stream deck tray (deck.rb) — listens for presses and runs commands
Exec="@DUBY_DIR@/bin/deck-tray-daemon"
Icon=input-keyboard
Terminal=false
X-KDE-autostart-after=panel
X-GNOME-Autostart-enabled=true

# Template: @DUBY_DIR@ is filled in with this checkout's path by
#   bin/install autostart        # writes ~/.config/autostart/deck.desktop
#
# Exec points at the TRAY (bin/deck-tray-daemon). To run WITHOUT a tray
# (headless), use `bin/install service` instead.
